<!-- Shutter design tokens for WPF. Merge into App.xaml alongside ShutterIcons.xaml. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

  <!-- Surfaces (darkest → lightest) -->
  <Color x:Key="Bg0Color">#111113</Color>   <!-- canvas well -->
  <Color x:Key="Bg1Color">#18181B</Color>   <!-- window -->
  <Color x:Key="Bg2Color">#202024</Color>   <!-- title bar, rail, side panels, status bar -->
  <Color x:Key="Bg3Color">#2A2A2F</Color>   <!-- buttons/controls at rest -->
  <Color x:Key="Bg4Color">#34343A</Color>   <!-- hover, selected nav item, active segment -->
  <Color x:Key="MenuColor">#26262B</Color>  <!-- menus, popovers, toasts -->
  <Color x:Key="LineColor">#12FFFFFF</Color>  <!-- hairline 7% -->
  <Color x:Key="Line2Color">#1FFFFFFF</Color> <!-- control border 12% -->
  <Color x:Key="Line3Color">#33FFFFFF</Color> <!-- strong border 20% -->

  <!-- Text -->
  <Color x:Key="TextColor">#EDEDF0</Color>
  <Color x:Key="Text2Color">#A6A6B0</Color>
  <Color x:Key="Text3Color">#74747E</Color>

  <!-- Accent & status -->
  <Color x:Key="AccentColor">#0A84FF</Color>
  <Color x:Key="AccentHoverColor">#2F95FF</Color>
  <Color x:Key="AccentPressColor">#0A6FDB</Color>
  <Color x:Key="AccentSoftColor">#290A84FF</Color> <!-- 16% -->
  <Color x:Key="AccentTextColor">#6CB4FF</Color>
  <Color x:Key="DangerColor">#FF5A50</Color>
  <Color x:Key="SuccessColor">#32D74B</Color>
  <Color x:Key="WarningColor">#FFD60A</Color>
  <Color x:Key="CloseHoverColor">#C42B1C</Color>
  <Color x:Key="DimOverlayColor">#9E050508</Color> <!-- capture overlay, 62% -->

  <!-- Annotation palette (unchanged order) -->
  <Color x:Key="InkRed">#FF453A</Color>
  <Color x:Key="InkOrange">#FF9F0A</Color>
  <Color x:Key="InkYellow">#FFD60A</Color>
  <Color x:Key="InkGreen">#32D74B</Color>
  <Color x:Key="InkBlue">#0A84FF</Color>
  <Color x:Key="InkPurple">#BF5AF2</Color>
  <Color x:Key="InkBlack">#1C1C1E</Color>
  <Color x:Key="InkWhite">#FFFFFF</Color>

  <!-- Brushes -->
  <SolidColorBrush x:Key="Bg0Brush" Color="{StaticResource Bg0Color}"/>
  <SolidColorBrush x:Key="Bg1Brush" Color="{StaticResource Bg1Color}"/>
  <SolidColorBrush x:Key="Bg2Brush" Color="{StaticResource Bg2Color}"/>
  <SolidColorBrush x:Key="Bg3Brush" Color="{StaticResource Bg3Color}"/>
  <SolidColorBrush x:Key="Bg4Brush" Color="{StaticResource Bg4Color}"/>
  <SolidColorBrush x:Key="MenuBrush" Color="{StaticResource MenuColor}"/>
  <SolidColorBrush x:Key="LineBrush" Color="{StaticResource LineColor}"/>
  <SolidColorBrush x:Key="Line2Brush" Color="{StaticResource Line2Color}"/>
  <SolidColorBrush x:Key="Line3Brush" Color="{StaticResource Line3Color}"/>
  <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
  <SolidColorBrush x:Key="Text2Brush" Color="{StaticResource Text2Color}"/>
  <SolidColorBrush x:Key="Text3Brush" Color="{StaticResource Text3Color}"/>
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
  <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
  <SolidColorBrush x:Key="AccentPressBrush" Color="{StaticResource AccentPressColor}"/>
  <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}"/>
  <SolidColorBrush x:Key="AccentTextBrush" Color="{StaticResource AccentTextColor}"/>
  <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
  <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
  <SolidColorBrush x:Key="CloseHoverBrush" Color="{StaticResource CloseHoverColor}"/>
  <SolidColorBrush x:Key="DimOverlayBrush" Color="{StaticResource DimOverlayColor}"/>

  <!-- Type -->
  <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>
  <sys:Double x:Key="FontWindowTitle">20</sys:Double>  <!-- Semibold -->
  <sys:Double x:Key="FontBody">13</sys:Double>
  <sys:Double x:Key="FontControl">12.5</sys:Double>
  <sys:Double x:Key="FontCaption">11.5</sys:Double>
  <sys:Double x:Key="FontGroupLabel">11</sys:Double>   <!-- Semibold, caps, +0.06em -->

  <!-- Radius -->
  <CornerRadius x:Key="RadiusXs">4</CornerRadius>  <!-- keycaps -->
  <CornerRadius x:Key="RadiusSm">6</CornerRadius>  <!-- buttons, inputs -->
  <CornerRadius x:Key="RadiusMd">8</CornerRadius>  <!-- rail buttons, cards, menus, windows -->
  <CornerRadius x:Key="RadiusLg">12</CornerRadius> <!-- toasts, preview card, floating strips -->

  <!-- Sizes -->
  <sys:Double x:Key="TitleBarHeight">40</sys:Double>
  <sys:Double x:Key="ContextBarHeight">44</sys:Double>
  <sys:Double x:Key="StatusBarHeight">28</sys:Double>
  <sys:Double x:Key="RailWidth">52</sys:Double>
  <sys:Double x:Key="RailButtonSize">36</sys:Double>
  <sys:Double x:Key="IconButtonSize">32</sys:Double>
  <sys:Double x:Key="SidePanelWidth">300</sys:Double>
  <sys:Double x:Key="IconStroke">1.6</sys:Double>

  <!-- Shadows -->
  <DropShadowEffect x:Key="PopoverShadow" BlurRadius="40" ShadowDepth="16" Direction="270" Opacity="0.5" Color="Black"/>
  <DropShadowEffect x:Key="PinShadow" BlurRadius="50" ShadowDepth="18" Direction="270" Opacity="0.6" Color="Black"/>
</ResourceDictionary>
